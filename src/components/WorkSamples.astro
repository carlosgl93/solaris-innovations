---
// TODO: Replace placeholders with real project data from Carlos
const projects: {
  title: string;
  description: string;
  tags: string[];
  image?: string;
}[] = [
  {
    title: 'Proyecto 1',
    description: 'Descripción del proyecto próximamente.',
    tags: ['Astro', 'Figma-to-code'],
  },
  {
    title: 'Proyecto 2',
    description: 'Descripción del proyecto próximamente.',
    tags: ['Next.js', 'Headless CMS'],
  },
  {
    title: 'Proyecto 3',
    description: 'Descripción del proyecto próximamente.',
    tags: ['Astro', 'Multiidioma'],
  },
];
---

<section id="proyectos" class="py-24 px-6 bg-[#0d0e10]">
  <div class="max-w-6xl mx-auto">
    <p class="text-xs text-white/40 uppercase tracking-widest mb-4">Proyectos</p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-16 max-w-lg leading-tight">
      Diseños que llegan a producción.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <article class="group rounded-2xl border border-white/8 bg-white/4 overflow-hidden flex flex-col">
          <!-- Image placeholder -->
          <div class="aspect-video bg-white/6 flex items-center justify-center">
            {project.image
              ? <img src={project.image} alt={project.title} class="w-full h-full object-cover" loading="lazy" />
              : <span class="text-white/20 text-sm">Imagen próximamente</span>
            }
          </div>

          <div class="p-6 flex flex-col gap-3 flex-1">
            <h3 class="text-white font-semibold text-base">{project.title}</h3>
            <p class="text-white/55 text-sm leading-relaxed font-light flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-2 pt-2">
              {project.tags.map(tag => (
                <span class="text-xs text-white/40 border border-white/15 rounded-full px-3 py-1">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
